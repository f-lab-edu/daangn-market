<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.limikju.daangn_market.repository.CategoryRepository">
  <select id="hasChild">
    SELECT NOT EXISTS (
    SELECT 1
    FROM CATEGORY
    WHERE parent_id = #{id}
    );
  </select>

  <select id="findById" resultType="com.limikju.daangn_market.domain.dto.CategoryInfoDto">
    SELECT * FROM CATEGORY WHERE id = #{id}
  </select>

  <select id="findByTitle" resultType="com.limikju.daangn_market.domain.dto.CategoryInfoDto">
    SELECT * FROM CATEGORY WHERE title = #{title}
  </select>

  <select id="findAll" resultType="com.limikju.daangn_market.domain.dto.CategoryInfoDto">
    SELECT * FROM CATEGORY
  </select>
</mapper>